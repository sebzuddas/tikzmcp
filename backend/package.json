{
  "name": "tikzmcp-backend",
  "version": "1.1.0",
  "description": "MCP server that renders TikZ diagrams to SVG",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tikzmcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "verify": "tsx scripts/verify.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
